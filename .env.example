# Public application URLs
APP_BASE_URL=https://your-cwp-sms-domain.example
CORS_ALLOWED_ORIGINS=https://your-cwp-sms-domain.example

# Firebase Admin (server-side only; configure in Vercel environment settings)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PLACEHOLDER_ONLY\n-----END PRIVATE KEY-----\n"

# Secret values: generate unique random values per environment; never commit real values
CWP_API_KEY_HASH_PEPPER=replace-with-a-long-random-secret
CWP_DEVICE_TOKEN_HASH_PEPPER=replace-with-a-different-long-random-secret

# Platform configuration
NODE_ENV=development
CWP_DEFAULT_MODE=demo
CWP_LIVE_SENDING_ENABLED=false
CWP_MAX_REQUEST_BODY_BYTES=16384
CWP_DEFAULT_REQUESTS_PER_MINUTE=5
CWP_DEFAULT_DAILY_SMS_UNITS=50
CWP_DEFAULT_MAX_CONNECTED_DEVICES=1
CWP_JOB_LEASE_SECONDS=60
CWP_JOB_EXPIRY_SECONDS=900
CWP_MESSAGE_RETENTION_DAYS=30
CWP_AUDIT_RETENTION_DAYS=180

# Optional local testing only; unset in production
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
