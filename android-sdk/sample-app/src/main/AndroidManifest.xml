    <application android:label="CWP SMS" android:icon="@drawable/ic_logo_ember" android:roundIcon="@drawable/ic_logo_ember" android:allowBackup="false">
        <!-- Lets the SDK's theme picker switch the launcher icon (one alias per theme below). -->
        <meta-data android:name="com.cwp.sms.ICON_ALIAS_PREFIX" android:value="com.cwp.sample.icon." />
        <activity android:name=".MainActivity" android:exported="false" />
