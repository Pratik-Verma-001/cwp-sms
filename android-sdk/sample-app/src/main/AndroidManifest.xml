            android:enabled="true" android:label="CWP SMS" android:icon="@drawable/ic_logo_ember" android:roundIcon="@drawable/ic_logo_ember">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
